# Documentation only: MolQuarry reads the process environment, it does not auto-load .env.
# Set only credentials for accounts you are authorized to use. Never commit real values.
GTOPDB_API_KEY=
REAL_API_KEY=
CHEMSPACE_API_KEY=
MOLPORT_API_KEY=
LENS_API_TOKEN=
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
COMPTOX_API_KEY=
USPTO_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_ACCESS_TOKEN=
# Optional GCS bearer token; current anonymous PLINDER listing is denied.
PLINDER_GCP_ACCESS_TOKEN=
# Optional local storage root:
# MOLQUARRY_HOME=/absolute/path/to/your/project/.molquarry
