  "cards": [
    {
      "dot": "cyan",
      "title": "图中的读 H / 写 H 都指同一历史",
      "items": [
        "四行是四类操作，不是四个库或四套复制。读接口不产生新科学结果。",
        "搜索层记录、计划、分支、golden、step 内容契约待新增；claim 与实际实验记录复用已有接口。"
      ]
    },
    {
      "dot": "emerald",
      "title": "已有的持久化边界",
      "items": [
        "Artifact 校验哈希与字节，Journal 同身份不可改写；执行费用引用原账本。",
        "文件先完整落地，随后 Journal 入库；数据库失败保留可核验文件供重试，不冒充跨存储原子事务。",
        "failed / missing / unsupported 保留各自状态，不填成低分或实验阴性。"
      ]
    },
    {
      "dot": "amber",
      "title": "待新增的读写与更新语义",
      "items": [
        "查询覆盖、分支理由、supersedes 和反向依赖驱动当前视图更新；索引可以重建。",
        "新增内容 schema 需要同步增加验证、只读投影与发布规则；当前 query 是子串搜索，lineage 仅直接关系。",
        "golden 回归、阳性保留、候选通过与 lab 确认分开统计分母、缺失和覆盖。"
      ]
    }
