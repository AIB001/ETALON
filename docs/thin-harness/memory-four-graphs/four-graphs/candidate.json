  "cards": [
    {
      "dot": "cyan",
      "title": "四图共享身份，不是四套数据库",
      "items": [
        "E/J/X/R 都是待新增的关系视图；底层 Journal、claim、Artifact、Experiment、Observation 已有。",
        "R → E 复用同一 EvidenceRef，不重复生成独立证据或重复记费。",
        "J 的新判断继续影响 E 的检索和 X 的实验；R 的支持与反证通过 H 更新 J。"
      ]
    },
    {
      "dot": "amber",
      "title": "整层和分支都可以跳过",
      "items": [
        "箭头是可选关系，不是每轮必走的流水线。已有协议和证据足够时，可直接选择 X 的相关分支。",
        "无区分力分支可以停止；保留依据、条件和重新考虑条件。未执行结果保持未知。",
        "已有：数值与实验记录基础。待新增：通用分支、关系投影、frontier 与 golden manifest。"
      ]
    },
    {
      "dot": "emerald",
      "title": "原架构能力如何接入",
      "items": [
        "搜索与来源：MolQuarry / data-design；判断与对照：research / campaign。",
        "实验调用：现有 SDK 与 runtime；结果保存：ResearchJournal 和 evidence。",
        "化学合成 / 采购 / lab 为 X 的候选路线，真实批次与测量进入 R；完整实时 lab 接口仍待新增。"
      ]
    }
  ]
