  "cards": [
    {
      "dot": "cyan",
      "title": "接续先读状态，不重复派发",
      "items": [
        "已有：短入口、evidence query/read、原 handle 与收据读取。待新增：handoff、frontier、水位过期检查。",
        "旧快照只导航；新 chat 读取当前暂停与归属，先回查 pending，再决定是否执行。",
        "后续采用/回退及新事实进入 H；下一份接续快照引用其版本，不复制整个聊天历史。"
      ]
    },
    {
      "dot": "amber",
      "title": "触发有条件，事实不丢失",
      "items": [
        "已核验严重错误可触发一次局部修复；重复独立任务失败达到预定阈值、改变适用性的新证据或阶段复盘可触发改进。",
        "普通 memory 写入、读取和“生成了一个新版本”不自动触发下一轮；候选可以为零。",
        "已有 consume_events 提供有界读取与稳定 request ID；触发去重、合并信号和尝试上限待新增。"
      ]
    },
    {
      "dot": "emerald",
      "title": "S 与 U 分开归因",
      "items": [
        "方法 S 比较尽量固定任务、信息与分支；选择 U 比较尽量固定可用方法与信息。",
        "未执行分支的收益保持未知，不能用已选分支的成功反推全部选择正确。",
        "现有 MethodEvaluation 的独立验证依赖冻结策略收据；通用 S/U 评价仍需适配，记录存在不等于收益成立。"
      ]
    },
    {
      "dot": "cyan",
      "title": "试用、采用与回退",
      "items": [
        "版本与使用记录可复用；choice 默认选择记录和后续绑定约定待新增。",
        "保留 no-change、失败与真实成本；回退改变后续选择，不删除旧结果，不热替换运行中任务。",
        "G 绑定本次改进方法的版本；本轮只改 S/U，不建立 G 递归改进循环。"
      ]
    }
  ]
