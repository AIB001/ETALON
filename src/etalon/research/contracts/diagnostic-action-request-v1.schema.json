{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "prism-diagnostic-action-request/1"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "design_input",
              "diagnostic_input",
              "independent_validation",
              "sealed_holdout"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ]
      }
    },
    "input_identity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "molecule_id": {
              "type": "string",
              "minLength": 1
            },
            "chemical_state_id": {
              "type": "string",
              "minLength": 1
            },
            "pose_id": {
              "type": "string",
              "minLength": 1
            },
            "receptor_state_id": {
              "type": "string",
              "minLength": 1
            },
            "coordinate_frame_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "molecule_id",
            "chemical_state_id",
            "pose_id",
            "receptor_state_id",
            "coordinate_frame_id"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "num_poses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "core_tolerance_A": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.1
        }
      },
      "required": [
        "num_poses",
        "max_iterations",
        "core_tolerance_A"
      ]
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "edits": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 48
        },
        "expected_smiles": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "edits",
        "expected_smiles"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483600
    },
    "coupling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "shared_artifact_sha256s": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "randomness": {
          "enum": [
            "independent_seed",
            "shared_seed",
            "deterministic_reanalysis"
          ]
        },
        "independent_replicate": {
          "type": "boolean"
        }
      },
      "required": [
        "group_id",
        "shared_artifact_sha256s",
        "randomness",
        "independent_replicate"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        },
        "threads": {
          "const": 1
        }
      },
      "required": [
        "wall_seconds",
        "threads"
      ]
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_nature": {
      "enum": [
        "file_audit",
        "reanalysis",
        "replication",
        "intervention",
        "recovery"
      ]
    }
  },
  "required": [
    "schema_version",
    "capability",
    "experiment_id",
    "program_id",
    "action_id",
    "idempotency_key",
    "operation",
    "inputs",
    "input_identity",
    "parameters",
    "intervention",
    "seed",
    "coupling",
    "budget",
    "measurements",
    "method_id",
    "protocol_instance_id",
    "operation_nature"
  ]
}
