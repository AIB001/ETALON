{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "coupling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "shared_artifact_sha256s": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "randomness": {
          "enum": [
            "independent_seed",
            "shared_seed",
            "deterministic_reanalysis"
          ]
        },
        "independent_replicate": {
          "type": "boolean"
        }
      },
      "required": [
        "group_id",
        "shared_artifact_sha256s",
        "randomness",
        "independent_replicate"
      ]
    },
    "schema_version": {
      "const": "prism-fixed-pool-request/1"
    },
    "operation": {
      "const": "measure"
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "design_input",
              "diagnostic_input",
              "independent_validation",
              "sealed_holdout"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ]
      }
    },
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receptor_state_id": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_frame_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "receptor_state_id",
        "coordinate_frame_id"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scorer": {
          "enum": [
            "vina",
            "vinardo"
          ]
        },
        "center_A": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "size_A": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          }
        },
        "spacing_A": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.0
        }
      },
      "required": [
        "scorer",
        "center_A",
        "size_A",
        "spacing_A"
      ]
    },
    "poses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "pose_label": {
            "type": "string",
            "minLength": 1
          },
          "input_key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "expected_smiles": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "slot",
          "candidate_id",
          "pose_label",
          "input_key",
          "expected_smiles"
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "threads": {
          "const": 1
        }
      },
      "required": [
        "wall_seconds",
        "threads"
      ]
    }
  },
  "required": [
    "capability",
    "experiment_id",
    "program_id",
    "action_id",
    "idempotency_key",
    "method_id",
    "protocol_instance_id",
    "coupling",
    "schema_version",
    "operation",
    "inputs",
    "input_identity",
    "evaluation",
    "poses",
    "budget"
  ]
}
